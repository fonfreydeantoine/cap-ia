---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BandeauAppel from '../../components/BandeauAppel.astro';

const offres = (await getCollection('offres')).sort((a, b) => a.data.ordre - b.data.ordre);
---
<Base
  titre="Offres : audit, formation et accompagnement IA"
  description="Audit IA à partir de 490 €, formation à partir de 500 € la demi-journée, mise en place à partir de 690 € et suivi à partir de 150 € par mois. Des prix clairs, au forfait."
  image="/og/offres.png"
  ariane={[{ nom: 'Offres', lien: '/offres' }]}
>
  <section class="section">
    <div class="conteneur">
      <p class="repere">Offres</p>
      <h1>Trois façons de travailler ensemble</h1>
      <p class="intro">Vous pouvez commencer par n'importe laquelle, et vous arrêter après chacune. Les prix sont des forfaits : vous savez avant de commencer ce que vous paierez.</p>

      <div class="defilement comparatif">
        <table class="tableau">
          <caption class="visuellement-cache">Comparaison des trois offres</caption>
          <thead>
            <tr>
              <th scope="col">Offre</th>
              <th scope="col">Pour qui</th>
              <th scope="col">Ce que vous obtenez</th>
              <th scope="col">Prix</th>
            </tr>
          </thead>
          <tbody>
            {offres.map((o) => (
              <tr>
                <th scope="row"><a href={`/offres/${o.id}`}>{o.data.titreCourt}</a></th>
                <td>{o.data.pourQui}</td>
                <td>{o.data.resultat}</td>
                <td class="comparatif__prix">{o.data.prixCarte}{o.data.prixDetail && <span class="texte-doux"> {o.data.prixDetail}</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="grille grille--3">
        {offres.map((o) => (
          <article class="carte">
            <h2 class="carte__titre"><a href={`/offres/${o.id}`}>{o.data.titreCourt}</a></h2>
            <p>{o.data.resume}</p>
            <p class="prix">{o.data.prixCarte}</p>
            {o.data.prixDetail && <p class="prix-detail">{o.data.prixDetail}</p>}
          </article>
        ))}
      </div>

      <p class="texte-doux petit mention">Prix nets, TVA non applicable (art. 293 B du CGI).</p>
      <p class="lecture">Vous ne savez pas quelle formule choisir ? C'est précisément le rôle de l'appel découverte : en 30 minutes, nous regardons votre situation et je vous dis par où il me paraît le plus utile de commencer.</p>
    </div>
  </section>
  <BandeauAppel />
</Base>

<style>
  .comparatif { margin: 2rem 0 2.5rem; }
  .comparatif td.comparatif__prix { white-space: normal; min-width: 11rem; font-weight: 650; }
  .carte__titre { font-size: 1.5rem; }
  .carte__titre a { color: inherit; text-decoration: none; }
  .carte__titre a:hover { text-decoration: underline; text-decoration-color: var(--terre); }
  .mention { margin: 1.5rem 0 2rem; }
</style>
