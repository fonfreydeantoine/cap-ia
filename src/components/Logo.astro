---
// Logotype Cap IA : le repère de cap (anneau et triangle de relèvement) suivi du nom en Newsreader.
interface Props { lien?: boolean; clair?: boolean }
const { lien = true, clair = false } = Astro.props;
const Balise = lien ? 'a' : 'span';
---
<Balise class:list={['logo', { 'logo--clair': clair }]} href={lien ? '/' : undefined} aria-label={lien ? 'Cap IA, accueil' : undefined}>
  <svg class="logo__marque" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
    <circle cx="16" cy="18.5" r="10.5" fill="none" stroke="currentColor" stroke-width="2.4" />
    <path d="M16 2 L21.6 13.2 L16 10.6 L10.4 13.2 Z" fill="#B4532A" />
    <circle cx="16" cy="18.5" r="1.9" fill="currentColor" />
  </svg>
  <span class="logo__nom">Cap IA</span>
</Balise>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--encre);
    text-decoration: none;
  }
  .logo--clair { color: var(--papier); }
  .logo__marque { width: 2rem; height: 2rem; flex-shrink: 0; }
  .logo__nom {
    font-family: var(--police-titre);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  a.logo:hover { text-decoration: none; }
</style>
